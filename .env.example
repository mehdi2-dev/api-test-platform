# Bu dosyayı .env olarak kopyalayın. .env git'e eklenmez.

# Uygulama
APP_NAME=API Test Otomasyon Platformu
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_USER=apitest
POSTGRES_PASSWORD=apitest
POSTGRES_DB=apitest
DATABASE_URL=postgresql+psycopg://apitest:apitest@db:5432/apitest

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Güvenlik (ileriki sprintlerde kullanılacak; prod'da mutlaka değiştirin)
SECRET_KEY=degistir-beni-uzun-ve-rastgele-bir-deger
