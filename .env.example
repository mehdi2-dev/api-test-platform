# Bu dosyayı .env olarak kopyalayın. .env git'e eklenmez.

# Uygulama
APP_NAME=API Test Otomasyon Platformu
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_USER=apitest
POSTGRES_PASSWORD=apitest
POSTGRES_DB=apitest
DATABASE_URL=postgresql+psycopg://apitest:apitest@db:5432/apitest

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Güvenlik — prod'da mutlaka uzun ve rastgele bir değerle değiştirin
SECRET_KEY=degistir-beni-uzun-ve-rastgele-bir-deger
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Token/şifre gibi gizli değerleri şifreleyen anahtar. Boşsa SECRET_KEY'den türetilir.
# Üretmek için: docker compose exec backend python -m app.cli generate-key
ENCRYPTION_KEY=
# Anahtar değiştirirken eski anahtar(lar), virgülle (sadece çözmek için). README > Güvenlik.
ENCRYPTION_KEY_PREVIOUS=

# Kaba kuvvet koruması: bu kadar hatalı girişten sonra hesap bu süre kilitlenir (saniye)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# Test edilen API'lere giden isteklerin zaman aşımı (saniye)
REQUEST_TIMEOUT_SECONDS=30

# Zamanlanmış çalıştırmaların (cron) saat dilimi
TIMEZONE=Europe/Istanbul

# Bildirim mesajlarındaki bağlantılar için arayüz adresi
FRONTEND_URL=http://localhost:5173

# E-posta bildirimleri (boş bırakılırsa e-posta kanalları hata verir; Slack/Teams/webhook çalışır)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=api-test@localhost
SMTP_USE_TLS=true

# Veritabanında hiç kullanıcı yoksa açılışta oluşturulan ilk admin
FIRST_ADMIN_EMAIL=admin@apitest.com
FIRST_ADMIN_PASSWORD=Admin12345

# Örnek senaryoların hedefi (demo CRM servisi)
DEMO_BASE_URL=http://demo:8001
