{
  "format": "api-test-platform/collection",
  "version": 1,
  "name": "Örnek 2 · Lead ve teklif oluşturma",
  "description": "Giriş → lead oluştur → lead için teklif oluştur → lead durumunu ve şirketin tekliflerini doğrula. E-posta her çalıştırmada {{$uuid}} ile benzersiz üretilir.",
  "stop_on_failure": true,
  "apis": [
    {
      "name": "Demo · Giriş",
      "description": "Kullanıcı adı ve şifreyle giriş yapar, token alır.",
      "method": "POST",
      "url": "{{base_url}}/auth/login",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "enabled": true
        }
      ],
      "query_params": [],
      "body_type": "json",
      "body": "{\n  \"username\": \"{{demo_user}}\",\n  \"password\": \"{{demo_password}}\"\n}",
      "auth": {
        "type": "none"
      },
      "assertions": [
        {
          "type": "status_code",
          "operator": "equals",
          "expected": "200",
          "enabled": true
        },
        {
          "type": "response_time",
          "operator": "less_than",
          "expected": "2000",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.access_token",
          "operator": "exists",
          "expected": null,
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.access_token",
          "operator": "type_is",
          "expected": "string",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.expires_in",
          "operator": "greater_than",
          "expected": "0",
          "enabled": true
        }
      ]
    },
    {
      "name": "Demo · Lead oluştur",
      "description": "Ege Gıda için yeni lead oluşturur.",
      "method": "POST",
      "url": "{{base_url}}/leads",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "enabled": true
        }
      ],
      "query_params": [],
      "body_type": "json",
      "body": "{\n  \"company_id\": 2,\n  \"contact_name\": \"Ayşe Yılmaz\",\n  \"email\": \"ayse-{{$uuid}}@demo-firma.com\"\n}",
      "auth": {
        "type": "bearer",
        "token": "{{token}}"
      },
      "assertions": [
        {
          "type": "status_code",
          "operator": "equals",
          "expected": "201",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.id",
          "operator": "type_is",
          "expected": "number",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.status",
          "operator": "equals",
          "expected": "new",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.company_name",
          "operator": "equals",
          "expected": "Ege Gıda Ltd.",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.email",
          "operator": "contains",
          "expected": "@demo-firma.com",
          "enabled": true
        }
      ]
    },
    {
      "name": "Demo · Teklif oluştur",
      "description": "Önceki adımda oluşan lead için teklif verir.",
      "method": "POST",
      "url": "{{base_url}}/offers",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "enabled": true
        }
      ],
      "query_params": [],
      "body_type": "json",
      "body": "{\n  \"lead_id\": \"{{lead_id}}\",\n  \"amount\": 15000,\n  \"currency\": \"TRY\"\n}",
      "auth": {
        "type": "bearer",
        "token": "{{token}}"
      },
      "assertions": [
        {
          "type": "status_code",
          "operator": "equals",
          "expected": "201",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.lead_id",
          "operator": "equals",
          "expected": "{{lead_id}}",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.amount",
          "operator": "equals",
          "expected": "15000",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.status",
          "operator": "equals",
          "expected": "draft",
          "enabled": true
        }
      ]
    },
    {
      "name": "Demo · Lead detayı",
      "description": "Teklif sonrası lead durumunun 'offered' olduğunu kontrol eder.",
      "method": "GET",
      "url": "{{base_url}}/leads/{{lead_id}}",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "enabled": true
        }
      ],
      "query_params": [],
      "body_type": "none",
      "body": null,
      "auth": {
        "type": "bearer",
        "token": "{{token}}"
      },
      "assertions": [
        {
          "type": "status_code",
          "operator": "equals",
          "expected": "200",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.status",
          "operator": "equals",
          "expected": "offered",
          "enabled": true
        }
      ]
    },
    {
      "name": "Demo · Şirketin teklifleri",
      "description": "Şirketin teklif listesinde yeni teklifin olduğunu doğrular.",
      "method": "GET",
      "url": "{{base_url}}/companies/{{company_id}}/offers",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "enabled": true
        }
      ],
      "query_params": [],
      "body_type": "none",
      "body": null,
      "auth": {
        "type": "bearer",
        "token": "{{token}}"
      },
      "assertions": [
        {
          "type": "status_code",
          "operator": "equals",
          "expected": "200",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$",
          "operator": "type_is",
          "expected": "array",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$[-1].id",
          "operator": "equals",
          "expected": "{{offer_id}}",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$[-1].currency",
          "operator": "equals",
          "expected": "TRY",
          "enabled": true
        }
      ]
    }
  ],
  "steps": [
    {
      "api": 0,
      "enabled": true,
      "extractions": [
        {
          "variable": "token",
          "source": "json_path",
          "path": "$.access_token",
          "secret": true
        }
      ]
    },
    {
      "api": 1,
      "enabled": true,
      "extractions": [
        {
          "variable": "lead_id",
          "source": "json_path",
          "path": "$.id",
          "secret": false
        },
        {
          "variable": "company_id",
          "source": "json_path",
          "path": "$.company_id",
          "secret": false
        }
      ]
    },
    {
      "api": 2,
      "enabled": true,
      "extractions": [
        {
          "variable": "offer_id",
          "source": "json_path",
          "path": "$.id",
          "secret": false
        }
      ]
    },
    {
      "api": 3,
      "enabled": true,
      "extractions": []
    },
    {
      "api": 4,
      "enabled": true,
      "extractions": []
    }
  ],
  "required_variables": [
    "base_url",
    "demo_password",
    "demo_user"
  ]
}
