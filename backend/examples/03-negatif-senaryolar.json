      ],
      "query_params": [],
      "body_type": "none",
      "body": null,
      "auth": {
        "type": "bearer",
        "token": "gecersiz-token-123"
      },
      "assertions": [
        {
          "type": "status_code",
          "operator": "equals",
          "expected": "401",
          "enabled": true
        }
      ]
    },
