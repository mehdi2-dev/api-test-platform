      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "enabled": true
        }
      ],
      "query_params": [],
      "body_type": "none",
      "body": null,
      "auth": {
        "type": "none"
      },
      "assertions": [
        {
          "type": "status_code",
          "operator": "equals",
          "expected": "401",
          "enabled": true
        },
        {
          "type": "header",
          "target": "WWW-Authenticate",
          "operator": "exists",
          "expected": null,
          "enabled": true
        }
      ]
    },
    {
      "name": "Demo · Geçersiz token ile şirketler",
