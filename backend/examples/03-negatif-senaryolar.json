{
  "format": "api-test-platform/collection",
  "version": 1,
  "name": "Örnek 3 · Negatif senaryolar",
  "description": "Sistemin hatalı isteklere doğru cevap verdiğini doğrular: yanlış şifre, token'sız ve geçersiz token'la erişim, mükerrer lead, geçersiz tutar, olmayan kayıt. Her adım hatayı BEKLER; hepsi geçerse sistem doğru davranıyor demektir.",
  "stop_on_failure": false,
  "apis": [
    {
      "name": "Demo · Hatalı şifreyle giriş",
      "description": "Yanlış şifre 401 dönmeli.",
      "method": "POST",
      "url": "{{base_url}}/auth/login",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "enabled": true
        }
      ],
      "query_params": [],
      "body_type": "json",
      "body": "{\n  \"username\": \"{{demo_user}}\",\n  \"password\": \"yanlis-sifre\"\n}",
      "auth": {
        "type": "none"
      },
      "assertions": [
        {
          "type": "status_code",
          "operator": "equals",
          "expected": "401",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.detail",
          "operator": "contains",
          "expected": "hatalı",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.access_token",
          "operator": "not_exists",
          "expected": null,
          "enabled": true
        }
      ]
    },
    {
      "name": "Demo · Giriş",
      "description": "Kullanıcı adı ve şifreyle giriş yapar, token alır.",
      "method": "POST",
      "url": "{{base_url}}/auth/login",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "enabled": true
        }
      ],
      "query_params": [],
      "body_type": "json",
      "body": "{\n  \"username\": \"{{demo_user}}\",\n  \"password\": \"{{demo_password}}\"\n}",
      "auth": {
        "type": "none"
      },
      "assertions": [
        {
          "type": "status_code",
          "operator": "equals",
          "expected": "200",
          "enabled": true
        },
        {
          "type": "response_time",
          "operator": "less_than",
          "expected": "2000",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.access_token",
          "operator": "exists",
          "expected": null,
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.access_token",
          "operator": "type_is",
          "expected": "string",
          "enabled": true
        },
        {
          "type": "json_path",
          "target": "$.expires_in",
          "operator": "greater_than",
          "expected": "0",
          "enabled": true
        }
      ]
    },
    {
      "name": "Demo · Token olmadan şirketler",
